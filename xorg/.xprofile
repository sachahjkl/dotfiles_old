#!/bin/sh

# load settings from Xresources
[[ -f ~/.Xresources ]] && xrdb -merge -I$HOME ~/.Xresources

# Variables

# Startup Sequence
setxkbmap -layout fr &
nitrogen --restore 
picom --config ~/.config/picom/picom.conf -b 
#$HOME/.config/polybar/launch.sh
nm-applet &
blueman-applet &
#xautolock -time 5 -locker 
unclutter &
dunst -conf ~/.config/dunst/dunstrc &
mpd ~/.config/mpd/mpd.conf &
laptop_mode&
cbatticon&
psensor&
orage&
xss-lock --transfer-sleep-lock -- i3lock -f -m -k -B=10 --indicator --datecolor=FFFFFFFF --timecolor=FFFFFFFF &
#udiskie &
#kmix &
pasystray &
