# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 5
        separator = " <-> "
        color_separator = "#EDDE34"
}

#order += "ipv6"
order += "wireless _first_"
#order += "ethernet _first_"
#order += "battery all"
#order += "disk /"
order += "cpu_temperature avg"
#order += "cpu_temperature 0"
#order += "cpu_temperature 1"
#order += "cpu_temperature 2"
#order += "cpu_temperature 3"
order += "load"
order += "memory"
#order += "volume"
order += "tztime local"

wireless _first_ {
        format_up = "IP : %ip"
        format_down = "No Wifi"
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

volume master {
	format = "♪: %volume"
	format_muted = "♪: muted (%volume)"
	device = "pulse:alsa_output.pci-0000_00_1f.3.analog-stereo"
}

cpu_temperature avg {
	   format = "CPU° -> ±%degrees °C"
	   path = "/sys/class/hwmon/hwmon3/temp1_input"
}

cpu_temperature 0 {
	   format = "%degrees °C"
	   path = "/sys/class/hwmon/hwmon3/temp2_input"
}

cpu_temperature 1 {
	   format = "%degrees °C"
	   path = "/sys/class/hwmon/hwmon3/temp3_input"
}

cpu_temperature 2 {
	   format = "%degrees °C"
	   path = "/sys/class/hwmon/hwmon3/temp4_input"
}

cpu_temperature 3 {
	   format = "%degrees °C"
	   path = "/sys/class/hwmon/hwmon3/temp5_input"
}

battery all {
        format = "%status %percentage %remaining"
}

disk "/" {
        format = "%avail"
}

load {
        format = "Average load -> %1min"
}


memory {
        format = "Memory [used->%used, free->%available]"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%^A %d %^B %Y~>%H:%M:%S"
}
